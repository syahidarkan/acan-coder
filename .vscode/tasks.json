{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$esbuild-watch"
    },
    {
      "label": "Watch Extension",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Watching...",
          "endsPattern": "Watching..."
        }
      }
    }
  ]
}
